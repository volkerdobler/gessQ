{
  "name": "gessq",
  "displayName": "gessQ",
  "description": "gess.Q Support",
  "version": "0.3.9",
  "publisher": "volkerdobler",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "gessq",
    "gess.Q",
    "survey",
    "questionnaire",
    "market research"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/volkerdobler/gessQ.git"
  },
  "bugs": {
    "url": "https://github.com/volkerdobler/gessQ/issues"
  },
  "homepage": "https://github.com/volkerdobler/gessQ#readme",
  "license": "AFL-3.0",
  "main": "./out/extension.js",
  "icon": "images/gessQ_icon.png",
  "contributes": {
    "languages": [
      {
        "id": "gessq",
        "aliases": [
          "gessQ",
          "gessq"
        ],
        "extensions": [
          ".q"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gessq",
        "scopeName": "source.gessQ",
        "path": "./language/gessq.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gessq",
        "path": "./language/snippets.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "gessQ",
      "properties": {
        "gessq.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "error",
          "description": "Verbosity of the gessQ Output channel ('gessQ')."
        },
        "gessq.debugMode": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "Deprecated: use 'gessq.logLevel' instead. When set, this is treated as logLevel = debug.",
          "description": "Deprecated. Enable debug logging (equivalent to gessq.logLevel = debug)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check && node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "pretest": "npm run typecheck",
    "test": "jest",
    "clean": "rimraf --glob out \"*.vsix\"",
    "package": "npm run check && node esbuild.js --production && vsce package",
    "tools:pdf2glossary": "node ./tools/pdf2glossary.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.2",
    "@types/node": "^22.14.0",
    "@types/vscode": "^1.99.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "jest": "^29.6.1",
    "pdf-parse": "^1.1.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.0.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/src/__tests__/__mocks__/vscode.ts"
    }
  },
  "__metadata": {
    "id": "8369ddfc-3ff3-4da4-8712-89df76ef2c89",
    "publisherId": "7c9d6a5c-7f0a-4217-8a96-4f84eae98522",
    "publisherDisplayName": "Volker Dobler"
  }
}
